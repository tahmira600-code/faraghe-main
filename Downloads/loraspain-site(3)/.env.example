# انسخ هذا الملف إلى .env.local على حاسوبك، أو ضع نفس الأسماء في Vercel > Settings > Environment Variables
# لا ترفع .env.local إلى GitHub ولا ترسله لأحد

# عنوان الموقع (يُستعمل في sitemap.xml و robots.txt)
NEXT_PUBLIC_SITE_URL=https://loraspain.vercel.app

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# بريد صاحب لوحة التحكم (أكثر من بريد: افصل بفاصلة)
ADMIN_EMAILS=

# Google Search Console: الرمز الموجود داخل content="…" في طريقة التحقق HTML tag
GOOGLE_SITE_VERIFICATION=

# اختياري: مفتاح Google Text-to-Speech (يمكن وضعه أيضا من لوحة التحكم)
GOOGLE_TTS_API_KEY=
